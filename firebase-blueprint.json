{
  "entities": {
    "Ticket": {
      "title": "Ticket",
      "description": "An order ticket created by an authenticated user requesting services.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the ticket"
        },
        "discordUsername": {
          "type": "string",
          "description": "User's discord username"
        },
        "projectType": {
          "type": "string",
          "description": "Type of database or setup request"
        },
        "projectDetails": {
          "type": "string",
          "description": "Details detailing the requirements"
        },
        "status": {
          "type": "string",
          "enum": ["open", "in-progress", "completed", "cancelled"],
          "description": "Current status of the ticket"
        },
        "userId": {
          "type": "string",
          "description": "The firebase auth uid of the ticket creator"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The email address of the creator"
        },
        "urgency": {
          "type": "string",
          "description": "Urgency (standard / rush)"
        },
        "paymentMethod": {
          "type": "string",
          "description": "Method of payment proposed (e.g., steam_gift)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the ticket was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the ticket was last updated"
        }
      },
      "required": ["discordUsername", "projectType", "projectDetails", "status", "userId", "email", "createdAt", "updatedAt"]
    },
    "Review": {
      "title": "Review",
      "description": "A customer feedback review rating out of 5 stars.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the review"
        },
        "ticketId": {
          "type": "string",
          "description": "Associated ticket ID"
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID of the reviewer"
        },
        "userName": {
          "type": "string",
          "description": "DisplayName of the reviewer"
        },
        "userPhoto": {
          "type": "string",
          "description": "Avatar photo URL of the reviewer"
        },
        "rating": {
          "type": "integer",
          "description": "Rating out of 5"
        },
        "feedback": {
          "type": "string",
          "description": "Text description of their experience"
        },
        "projectType": {
          "type": "string",
          "description": "The type of project that was delivered"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the review was written"
        }
      },
      "required": ["ticketId", "userId", "userName", "userPhoto", "rating", "feedback", "projectType", "createdAt"]
    },
    "PlatformStats": {
      "title": "PlatformStats",
      "description": "Global platform overriding metrics and statistics",
      "type": "object",
      "properties": {
        "deliveredCount": {
          "type": "integer",
          "description": "The total number of delivered orders"
        },
        "overallRating": {
          "type": "number",
          "description": "The overall star average out of 5.0"
        }
      },
      "required": ["deliveredCount", "overallRating"]
    }
  },
  "firestore": {
    "/tickets/{ticketId}": {
      "schema": "Ticket",
      "description": "User order tickets for services"
    },
    "/ratings/{ratingId}": {
      "schema": "Review",
      "description": "Platform customer ratings and reviews"
    },
    "/stats/{statsId}": {
      "schema": "PlatformStats",
      "description": "Global platform overriding stats and metrics"
    }
  }
}
